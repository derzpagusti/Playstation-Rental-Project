# --- Aplikasi ---
# local = pengembangan, production = server sungguhan
APP_ENV=local
# Ubah ke false di server sungguhan
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

# --- Database PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ps_rental
DB_USER=postgres
# Isi dengan password PostgreSQL di laptopmu
DB_PASSWORD=

# --- Session ---
# Masa berlaku login dalam detik (28800 = 8 jam)
SESSION_LIFETIME=28800

# --- CORS ---
# Alamat frontend yang boleh memanggil API, pisahkan dengan koma.
# Harus PERSIS sama dengan alamat yang dibuka di browser
# (localhost dan 127.0.0.1 dianggap berbeda).
CORS_ALLOWED_ORIGINS=http://localhost:5500

# --- Aturan bisnis ---
# Maksimal booking aktif per nomor HP
BOOKING_MAX_ACTIVE=2