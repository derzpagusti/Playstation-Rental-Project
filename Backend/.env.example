# JANGAN menaruh password asli di file ini (file ini di-commit ke Git).

# --- Aplikasi ---
# local = pengembangan, production = server sungguhan
APP_ENV=local
# Ubah ke false di server sungguhan
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

# --- Database PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ps_rental
DB_USER=postgres
# Isi dengan password PostgreSQL di laptopmu
DB_PASSWORD=

# --- Autentikasi (JWT) ---
# Buat dengan: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
# Masa berlaku token dalam detik (28800 = 8 jam)
JWT_EXPIRES_IN=28800

# --- CORS ---
# Alamat frontend yang boleh memanggil API, pisahkan dengan koma.
# 5500 adalah port bawaan Live Server di VS Code.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- Upload file ---
# Relatif terhadap folder Backend/, di luar public/
UPLOAD_PATH=uploads
# Dalam byte (2097152 = 2 MB)
UPLOAD_MAX_SIZE=2097152

# --- Aturan bisnis ---
# Maksimal booking aktif per nomor HP
BOOKING_MAX_ACTIVE=2