> {%
    client.test("Tolak device_id berupa array", function () {
        client.assert(response.status === 422, "Harus HTTP 422");
    });
%}


### 6. device_id bernilai nol
GET {{baseUrl}}/devices/pricing.php?device_id=0

> {%
    client.test("Tolak device_id nol", function () {
        client.assert(response.status === 422, "Harus HTTP 422");
    });
%}


### 7. Device tidak ditemukan
GET {{baseUrl}}/devices/pricing.php?device_id=2147483647

> {%
    client.test("Device tidak ditemukan", function () {
        client.assert(response.status === 404, "Harus HTTP 404");
        client.assert(response.body.code === "NOT_FOUND", "Kode tidak sesuai");
    });
%}


### 8. Method POST ditolak
POST {{baseUrl}}/devices/pricing.php
Content-Type: application/json

{
  "device_id": {{ps4DeviceId}}
}

> {%
    client.test("Tolak method POST", function () {
        client.assert(response.status === 405, "Harus HTTP 405");
        client.assert(response.body.code === "METHOD_NOT_ALLOWED", "Kode tidak sesuai");
    });
%}